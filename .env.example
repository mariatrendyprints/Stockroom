# Postgres connection strings from your Supabase project
# (Project Settings → Database → Connection string).
#
# DATABASE_URL: the POOLED connection (port 6543, "Transaction" mode).
#   Used by the running app — serverless hosts like Vercel open many
#   short-lived connections, and the pooler is what keeps that from
#   exhausting Postgres's connection limit.
# DIRECT_URL: the UNPOOLED connection (port 5432).
#   Used only by `prisma migrate` — schema migrations need a direct
#   connection, not one going through the pooler.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-xxxxx.pooler.supabase.com:5432/postgres"

# `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed script: creates the first admin account if none exists.
ADMIN_SEED_NAME="Admin"
ADMIN_SEED_EMAIL="admin@stockroom.local"
ADMIN_SEED_PASSWORD="change-me-now"
